# gazelle:python_root
load("//:pytest.bzl", "pytest_test")
load("@rules_python//python:defs.bzl", "py_binary", "py_library")

exports_files(
    ["pytest_main.py"],
    visibility = ["//src:__subpackages__"],
)

py_binary(
    name = "manage",
    srcs = ["manage.py"],
    visibility = ["//src:__subpackages__"],
    deps = ["@pip//django"],
)

py_library(
    name = "src",
    srcs = [
        "manage.py",
        "pytest_main.py",
    ],
    visibility = ["//src:__subpackages__"],
    deps = [
        "@pip//django",
        "@pip//pytest",
    ],
)

py_binary(
    name = "pytest_main",
    srcs = ["pytest_main.py"],
    visibility = ["//src:__subpackages__"],
    deps = ["@pip//pytest"],
)
